// ═══════════════════════════════════════════════════════════════
// GSL (GWW3 Symbolic Logic) — Lark EBNF Grammar v2
// ═══════════════════════════════════════════════════════════════
// Parser: Lark LALR + custom Indenter
// Reference: docs/RULE_ENGINE_CONCEPT.md
//
// Successfully parses: invariant rules, sanctions + distributions,
// nested IF/ELSE, multiple effects, top-level effects, combat rules.

start: (_NL | stmt)*

// ──────────────────────────────────────────
// Top-level statements
// ──────────────────────────────────────────

?stmt: match_stmt
     | let_stmt
     | if_block
     | effect_stmt
     | delayed_block
     | rule_delim

// MATCH — raw Cypher (passed to Neo4j driver as-is)
match_stmt: MATCH_LINE

// LET — variable binding (deferred or eager sample)
let_stmt: "LET" NAME "=" expr
        | "LET" NAME "~" expr               -> let_sample
        | "LET" NAME "=" "MIN" "(" name_list ")" -> let_min

name_list: NAME ("," NAME)*

// DELAYED — deferred effects
delayed_block: "DELAYED" "(" NUMBER "ticks" ")" _NL _INDENT effect_block _DEDENT

// Rule delimiter (optional decoration)
rule_delim: RULE_DELIM

// ──────────────────────────────────────────
// IF / THEN / ELSE — indentation-based
// ──────────────────────────────────────────

if_block: "IF" expr _NL _INDENT block _DEDENT

block: (_NL | block_stmt)*
?block_stmt: then_block
           | else_block
           | let_stmt
           | if_block
           | effect_stmt
           | match_stmt

then_block: "THEN" _NL _INDENT effect_block _DEDENT
else_block: "ELSE" _NL _INDENT effect_block _DEDENT

effect_block: (_NL | effect_line)*
?effect_line: effect_stmt
            | let_stmt
            | if_block
            | match_stmt

// ──────────────────────────────────────────
// Effect statements
// ──────────────────────────────────────────

effect_stmt: PROP_ACCESS "+=" expr tv?            -> effect_add
           | PROP_ACCESS "-=" expr tv?            -> effect_sub
           | PROP_ACCESS MOD_OP expr tv?          -> effect_mod
           | PROP_ACCESS "=" expr tv?             -> effect_set
           | PROP_ACCESS CONVERGE_KW "(" "target" "=" expr "," "rate" "=" expr ")" tv? -> effect_converge
           | PROP_ACCESS "EFFECT" MOD_OP expr     -> effect_modifier
           | "CREATE" CYPHER_INLINE tv?           -> graph_create
           | "DELETE" NAME tv?                    -> graph_delete

CONVERGE_KW.2: "⤳"
CYPHER_INLINE: /\([^\n]+/

// Truth Value ⟨probability, confidence⟩
tv: /⟨/ NUMBER "," NUMBER /⟩/

// ──────────────────────────────────────────
// Expressions (precedence: low → high)
// ──────────────────────────────────────────

?expr: or_expr

?or_expr: and_expr (OR_OP and_expr)*

?and_expr: not_expr (AND_OP not_expr)*

?not_expr: NOT_OP not_expr                -> negation
         | comparison

?comparison: arith (COMP_OP arith)?

?arith: term ((PLUS | MINUS) term)*

?term: factor ((STAR | TIMES | SLASH) factor)*

?factor: MINUS atom                       -> neg
       | atom TILDE                       -> sample_postfix
       | atom

?atom: NUMBER                             -> number
     | PROP_ACCESS                        -> prop_access
     | NAME                               -> var_ref
     | dist_call
     | "CLAMP" "(" expr "," expr "," expr ")"  -> clamp_fn
     | "MIN" "(" expr "," expr ")"             -> min_fn
     | "MAX" "(" expr "," expr ")"             -> max_fn
     | "CURRENT_TICK"                          -> current_tick
     | "(" expr ")"
     | "true"                                  -> bool_true
     | "false"                                 -> bool_false

// ──────────────────────────────────────────
// Distributions
// ──────────────────────────────────────────

dist_call: DIST_2P "(" expr "," expr ")"  -> dist_2param
         | DIST_1P "(" expr ")"           -> dist_1param

// Unicode distributions + ASCII fallbacks
DIST_2P.2: "𝒩" | "𝒰" | "𝐿𝑁" | "𝛽" | "LN" | "Beta" | "N"
DIST_1P.2: "ℬ" | "𝒫" | "ℰ" | "Bernoulli" | "Poisson" | "Exp"

// ──────────────────────────────────────────
// Operators
// ──────────────────────────────────────────

OR_OP: "∨" | "||"
AND_OP: "∧" | "&&"
NOT_OP: "¬" | "!"
COMP_OP: ">=" | "<=" | "≥" | "≤" | ">" | "<" | "==" | "!="
MOD_OP: "×=" | "*="
PLUS: "+"
MINUS: "-"
STAR: "*"
TIMES: "×"
SLASH: "/"
TILDE: "~"

// ──────────────────────────────────────────
// Terminals
// ──────────────────────────────────────────

// MATCH lines: high priority to prevent NAME matching "MATCH"
MATCH_LINE.3: /MATCH\s+[^\n]+/

// Rule delimiters (decorative lines)
RULE_DELIM.3: /═{3,}[^\n]*/

// Property access: Node.property (single terminal, avoids dot ambiguity)
PROP_ACCESS.2: /[a-zA-Z_]\w*\.[a-zA-Z_]\w*/

// Identifiers
NAME: /[a-zA-Z_]\w*/

// Numbers: support underscores (1_000_000), scientific notation (5e9), negative
NUMBER: /\-?\d[\d_]*(\.\d[\d_]*)?([eE][\-+]?\d+)?/

// ──────────────────────────────────────────
// Whitespace, Indentation, Comments
// ──────────────────────────────────────────

// Newline captures \n + leading whitespace (required for indentation tracking)
_NL: /(\r?\n[\t ]*)+/

// Ignore inline whitespace (tabs, spaces within a line)
%ignore /[\t \f]+/

// Ignore comments
%ignore /#[^\n]*/

// Indentation tokens (injected by GSLIndenter postlex)
%declare _INDENT _DEDENT
